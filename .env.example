# Vorlage: kopieren nach .env.admin bzw. .env.viewer und echte Werte eintragen
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_KEY_ID=DEINE_KEY_ID
B2_APP_KEY=DEIN_APPLICATION_KEY
B2_BUCKET=securevault-tnl

# Nur in .env.admin: Passwort fuer die Admin-Anmeldung im Web-Frontend
# und zufaelliger Schluessel fuer die Login-Session (z. B. python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_USER=Admin
ADMIN_PASSWORD=EIN_LANGES_PASSWORT
FLASK_SECRET_KEY=ZUFAELLIGER_SCHLUESSEL
